# The unit's shell must see LF. Git on Windows checks out CRLF by default
# (core.autocrlf=true), which breaks these scripts in a way that is hard to
# read: the shebang becomes "/bin/sh\r" so the file "does not exist", and
# "set -u\r" fails as an unknown option. The head unit has no sed, awk or tr
# to repair it afterwards, so pin the line endings here instead.
*.sh text eol=lf

# Payload - never touch these. The renderer binary has no extension, so it is
# named outright; .bin is the compiled shaders, .rgba the texture atlas.
*.jar  binary
*.so   binary
*.jpg  binary
*.png  binary
*.gif  binary
*.bin  binary
*.rgba binary
bin/maneuver_render binary
bin/altscreen_render binary
